# Managed by Ansible - do not edit. Everything a test differs in is in
# compose.yml; this only holds what all of them share.
# The burn tests are the ones a human follows, so plain `docker compose ps` and
# `docker compose logs -f` in this directory show them. Quick tests are started
# with `docker compose run`, which enables their profile on its own.
COMPOSE_PROFILES=burn
HOSTNAME_METRICS=http://{{ metrics_address }}:{{ metrics_prometheus_port }}
LOKI_URL=http://{{ metrics_address }}:{{ metrics_loki_port }}
LOKI_HOST={{ inventory_hostname }}
