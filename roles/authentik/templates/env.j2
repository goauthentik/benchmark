# Managed by Ansible - do not edit.
# Secrets are generated once and cached in credentials/ on the control node.
PG_PASS={{ authentik_pg_password }}
AUTHENTIK_SECRET_KEY={{ authentik_secret_key }}
# Consumed as the pyroscope SDK's server address by the Python components; the Go
# components additionally require AUTHENTIK_DEBUG=true.
AUTHENTIK_PYROSCOPE_HOST={{ authentik_pyroscope_host }}
AUTHENTIK_TARGET={{ authentik_target }}
AUTHENTIK_IMAGE={{ authentik_image }}
AUTHENTIK_TAG={{ authentik_tag }}
COMPOSE_PORT_HTTP={{ authentik_port_http }}
COMPOSE_PORT_HTTPS={{ authentik_port_https }}
COMPOSE_PORT_METRICS={{ authentik_port_metrics }}
COMPOSE_PORT_PG_EXPORTER={{ authentik_port_pg_exporter }}
PG_LOG_MIN_DURATION={{ authentik_pg_log_min_duration }}
LOKI_URL=http://{{ metrics_address }}:{{ metrics_loki_port }}
LOKI_HOST={{ inventory_hostname }}
AUTHENTIK_WEB__WORKERS={{ authentik_web_workers }}
AUTHENTIK_WEB__THREADS={{ authentik_web_threads }}
AUTHENTIK_BOOTSTRAP_PASSWORD={{ authentik_admin_password }}
AUTHENTIK_BOOTSTRAP_TOKEN={{ authentik_admin_token }}
AUTHENTIK_LOG_LEVEL=warning
