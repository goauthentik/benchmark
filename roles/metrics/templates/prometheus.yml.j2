---
# Managed by Ansible - do not edit.
global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    cluster: benchmarks
    prometheus: benchmarks
    prometheus_replica: "0"

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]
  - job_name: pyroscope
    static_configs:
      - targets: ["pyroscope:4040"]
  - job_name: loki
    static_configs:
      - targets: ["loki:3100"]
  - job_name: authentik
    static_configs:
      - targets:
{% for host in groups['authentik'] %}
          - "{{ hostvars[host].ansible_host | default(host) }}:{{ authentik_port_metrics }}"
{% endfor %}
  - job_name: postgres
    static_configs:
      - targets:
{% for host in groups['authentik'] %}
          - "{{ hostvars[host].ansible_host | default(host) }}:{{ authentik_port_pg_exporter }}"
{% endfor %}
  - job_name: node
    static_configs:
      - targets:
{% for host in (groups['metrics'] + groups['authentik'] + groups['tests']) | unique %}
          - "{{ hostvars[host].ansible_host | default(host) }}:{{ node_exporter_port }}"
{% endfor %}
