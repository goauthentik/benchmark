---
all:
  vars:
    ansible_user: root
  # Every host also runs node-exporter, scraped by Prometheus on the metrics host.
  children:
    # Prometheus, Loki, Pyroscope and Grafana. Receives k6 remote-write and the
    # container logs of the other hosts, scrapes authentik's metrics endpoint and
    # ingests its profiles.
    metrics:
      hosts:
        metrics-1:
          ansible_host: metrics.example.com
    # authentik server, worker and PostgreSQL, seeded with the generated blueprint.
    authentik:
      hosts:
        authentik-1:
          ansible_host: authentik.example.com
      vars:
        authentik_web_workers: 4
    # k6 load generator.
    tests:
      hosts:
        tests-1:
          ansible_host: tests.example.com
