---
all:
  vars:
    ansible_user: root
  children:
    # Prometheus, Grafana and Pyroscope. Receives k6 remote-write, scrapes
    # authentik's metrics endpoint and ingests its profiles.
    metrics:
      hosts:
        metrics-1:
          ansible_host: metrics.example.com
    # authentik server, worker and PostgreSQL, seeded with the generated blueprint.
    authentik:
      hosts:
        authentik-1:
          ansible_host: authentik.example.com
    # k6 load generator.
    tests:
      hosts:
        tests-1:
          ansible_host: tests.example.com
